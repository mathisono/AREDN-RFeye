#!/bin/sh
# AREDN RFeye heatmap-oriented node GUI

echo "Content-Type: text/html"
echo "Cache-Control: no-store"
echo

cat <<'HTML'
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>AREDN RFeye</title>
  <link rel="stylesheet" href="/a/css/theme.css">
  <link rel="stylesheet" href="/a/css/user.css">
  <link rel="stylesheet" href="/a/css/mobile.css">
  <style>
    body { margin: 1rem; font-family: system-ui, sans-serif; }
    .rfeye-wrap { max-width: 1100px; margin: 0 auto; }
    .rfeye-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap: .75rem; }
    .rfeye-card { border: 1px solid rgba(127,127,127,.35); border-radius: .6rem; padding: .75rem; background: rgba(127,127,127,.06); }
    .rfeye-row { display: flex; flex-wrap: wrap; gap: .5rem; align-items: end; margin: .5rem 0; }
    label { display: grid; gap: .2rem; font-size: .9rem; }
    input, select, button { font: inherit; padding: .35rem .5rem; }
    button { cursor: pointer; }
    canvas { width: 100%; border: 1px solid rgba(127,127,127,.35); border-radius: .5rem; background: #05070a; }
    #waveform { height: 220px; }
    #waterfall, #ambient { height: 160px; }
    pre { overflow: auto; max-height: 10rem; padding: .5rem; background: rgba(0,0,0,.12); border-radius: .4rem; }
    .ok { color: #15803d; font-weight: 700; }
    .bad { color: #b91c1c; font-weight: 700; }
    .muted { opacity: .75; }
    .warn { border-left: .3rem solid #f59e0b; padding-left: .6rem; }
  </style>
</head>
<body>
<div class="rfeye-wrap">
  <h2>AREDN RFeye</h2>
  <p class="muted">Node-side test tool. Current channel only. Not a calibrated spectrum analyzer.</p>

  <div class="rfeye-card warn">
    <b>Safety:</b> No channel hopping or channel changes. Capture data remains under <code>/tmp/rfeye</code>.
  </div>

  <div class="rfeye-grid">
    <div class="rfeye-card">
      <h3>Controls</h3>
      <div class="rfeye-row">
        <label>PHY <input id="phy" value="phy0" autocomplete="off"></label>
        <label>Bins
          <select id="bins"><option>64</option><option selected>128</option><option>256</option></select>
        </label>
        <label>Test length (s) <input id="seconds" type="number" min="1" max="20" value="10"></label>
      </div>
      <div class="rfeye-row">
        <button id="start">Start</button>
        <button id="stop">Stop</button>
        <button id="reset">Reset</button>
      </div>
      <div>Capture state: <b id="state" class="muted">idle</b></div>
      <div>Frames captured: <b id="frames">0</b></div>
      <div>No-frame count: <b id="noframes">0</b></div>
      <div>Last frame age: <b id="lastage">--</b></div>
      <div>Frame rate: <b id="framerate">0/min</b></div>
      <div>Capture progress: <b id="progress">0%</b></div>
      <div>Sample interval: <b id="interval">--</b></div>
      <div>Capture bytes: <b id="bytes">0</b></div>
      <div>Parser mode: <b id="parsermode">resync</b></div>
    </div>

    <div class="rfeye-card">
      <h3>Radio (trusted)</h3>
      <div>Freq: <b id="rfreq">--</b></div>
      <div>Channel: <b id="rchan">--</b></div>
      <div>Width: <b id="rwidth">--</b></div>
      <div>Mode: <b id="rmode">--</b></div>
      <div>Capture end: <b id="rend">--</b></div>
    </div>

    <div class="rfeye-card">
      <h3>Diagnostics</h3>
      <div>Waveform range: <b id="wrange">--</b></div>
      <div>Waterfall rows: <b id="wfrows">0</b></div>
      <div>Ambient rows: <b id="amrows">0</b></div>
      <div>Ambient mode: <b id="ammode">minute_peak</b></div>
      <div>Status: <b id="livestatus" class="muted">waiting for next frame</b></div>
    </div>
  </div>

  <h3>Waveform View</h3>
  <canvas id="waveform" width="1040" height="220"></canvas>

  <h3>Waterfall View</h3>
  <canvas id="waterfall" width="1040" height="160"></canvas>

  <h3>Ambient Noise Level</h3>
  <canvas id="ambient" width="1040" height="160"></canvas>

  <h3>Raw JSON</h3>
  <pre id="raw">Waiting for data...</pre>
</div>

<script>
(function () {
  const api = '/cgi-bin/apps/rfeye/data/agent.sh';
  const raw = document.getElementById('raw');
  const waveform = document.getElementById('waveform').getContext('2d');
  const waterfall = document.getElementById('waterfall').getContext('2d');
  const ambient = document.getElementById('ambient').getContext('2d');
  let lastWaveform = null, lastWaterfall = null, lastAmbient = null;

  function qs(action) {
    const phy = encodeURIComponent(document.getElementById('phy').value || 'phy0');
    const bins = encodeURIComponent(document.getElementById('bins').value || '128');
    const seconds = encodeURIComponent(document.getElementById('seconds').value || '10');
    return `${api}?action=${action}&phy=${phy}&bins=${bins}&seconds=${seconds}`;
  }

  async function getJson(url) {
    const r = await fetch(url, { cache: 'no-store' });
    const t = await r.text();
    try { return JSON.parse(t); }
    catch (e) { return { ok: false, error: 'invalid json', body: t }; }
  }

  function setState(txt, good) {
    const el = document.getElementById('state');
    el.textContent = txt;
    el.className = good === true ? 'ok' : good === false ? 'bad' : 'muted';
  }

  function powerColor(v, minv, maxv) {
    if (!Number.isFinite(v)) return 'rgb(5,7,10)';
    const t = Math.max(0, Math.min(1, (v - minv) / (maxv - minv || 1)));
    if (t < 0.33) {
      const k = t / 0.33;
      return `rgb(${Math.round(0)},${Math.round(120*k)},${Math.round(220 + 35*k)})`;
    }
    if (t < 0.66) {
      const k = (t - 0.33) / 0.33;
      return `rgb(${Math.round(20 + 220*k)},${Math.round(120 + 90*k)},${Math.round(255 - 180*k)})`;
    }
    const k = (t - 0.66) / 0.34;
    return `rgb(${Math.round(240 + 15*k)},${Math.round(210 - 140*k)},${Math.round(70 - 60*k)})`;
  }

  function drawWaveform(w) {
    const c = waveform.canvas;
    const bins = (w && w.bins) || [];
    waveform.fillStyle = '#05070a';
    waveform.fillRect(0, 0, c.width, c.height);
    waveform.strokeStyle = '#1f2937';
    for (let i = 1; i < 5; i++) {
      const y = Math.round((c.height / 5) * i);
      waveform.beginPath(); waveform.moveTo(0, y); waveform.lineTo(c.width, y); waveform.stroke();
    }
    if (!bins.length) return;
    let minv = Infinity, maxv = -Infinity;
    for (const v of bins) { if (v < minv) minv = v; if (v > maxv) maxv = v; }
    if (!isFinite(minv) || !isFinite(maxv) || minv === maxv) { minv = -125; maxv = -65; }
    waveform.strokeStyle = '#22d3ee';
    waveform.lineWidth = 2;
    waveform.beginPath();
    bins.forEach((v, i) => {
      const x = bins.length === 1 ? 0 : (i / (bins.length - 1)) * c.width;
      const y = c.height - ((v - minv) / (maxv - minv || 1)) * (c.height - 16) - 8;
      if (i === 0) waveform.moveTo(x, y); else waveform.lineTo(x, y);
    });
    waveform.stroke();
  }

  function drawHeat(ctx, rows, minv, maxv) {
    const c = ctx.canvas;
    ctx.fillStyle = '#05070a';
    ctx.fillRect(0, 0, c.width, c.height);
    if (!rows || !rows.length) return;
    const bins = ((rows[0] && rows[0].bins) || []).length;
    if (!bins) return;
    const cellW = c.width / bins;
    const cellH = c.height / rows.length;
    rows.forEach((row, r) => {
      const arr = row.bins || [];
      for (let i = 0; i < bins; i++) {
        ctx.fillStyle = powerColor(arr[i], minv, maxv);
        ctx.fillRect(i * cellW, c.height - ((r + 1) * cellH), Math.ceil(cellW), Math.ceil(cellH));
      }
    });
  }

  function applyBundle(j) {
    raw.textContent = JSON.stringify(j, null, 2);
    if (!j.ok) { setState(j.error || 'error', false); return; }

    const c = j.capture || {};
    const r = (j.radio && j.radio.ok) ? j.radio : {};
    let w = j.waveform || {};
    let wf = j.waterfall || { rows: [], min_dbm: -125, max_dbm: -65 };
    let am = j.ambient || { rows: [], mode: 'minute_peak' };
    const m = j.capture_metrics || {};
    if ((w.bins || []).length) lastWaveform = w; else if (lastWaveform) w = lastWaveform;
    if ((wf.rows || []).length) lastWaterfall = wf; else if (lastWaterfall) wf = lastWaterfall;
    if ((am.rows || []).length) lastAmbient = am; else if (lastAmbient) am = lastAmbient;

    document.getElementById('frames').textContent = String(c.frames_captured || 0);
    document.getElementById('noframes').textContent = String(c.no_frame_count || 0);
    document.getElementById('bytes').textContent = String(c.bytes_written || m.bytes_written || 0);
    document.getElementById('lastage').textContent = (m.last_frame_age_seconds ?? -1) >= 0 ? `${m.last_frame_age_seconds}s` : '--';
    document.getElementById('framerate').textContent = `${m.frames_per_minute ?? '0.0'}/min (${m.frames_per_second ?? '0.00'}/s)`;
    document.getElementById('progress').textContent = `${m.capture_progress_percent ?? 0}%`;
    document.getElementById('interval').textContent = `${m.sample_interval_ms ?? '--'} ms / ${m.snapshot_bytes ?? '--'} bytes`;
    document.getElementById('parsermode').textContent = m.parser_mode || 'resync';
    document.getElementById('rfreq').textContent = r.frequency_mhz ? `${r.frequency_mhz} MHz` : '--';
    document.getElementById('rchan').textContent = r.channel || '--';
    document.getElementById('rwidth').textContent = r.width_mhz ? `${r.width_mhz} MHz` : '--';
    document.getElementById('rmode').textContent = r.mode || '--';
    document.getElementById('rend').textContent = c.ends_at ? String(c.ends_at) : '--';
    document.getElementById('wrange').textContent = `${w.x_start_mhz ?? '--'} to ${w.x_end_mhz ?? '--'} MHz`;
    document.getElementById('wfrows').textContent = String((wf.rows || []).length);
    document.getElementById('amrows').textContent = String((am.rows || []).length);
    document.getElementById('ammode').textContent = am.mode || 'minute_peak';

    const hasRows = ((wf.rows || []).length > 0) || ((w.bins || []).length > 0);
    if (c.state === 'running') setState(hasRows ? 'running' : 'waiting for next frame', true);
    else if (c.state === 'error' && hasRows) setState('waiting for next frame', null);
    else if (c.state === 'error') setState('error', false);
    else setState(c.state || 'idle', null);
    document.getElementById('livestatus').textContent = hasRows ? 'live data available' : 'waiting for next frame';

    drawWaveform(w);
    drawHeat(waterfall, wf.rows || [], wf.min_dbm ?? -125, wf.max_dbm ?? -65);
    drawHeat(ambient, am.rows || [], wf.min_dbm ?? -125, wf.max_dbm ?? -65);
  }

  async function pollBundle() {
    applyBundle(await getJson(qs('heatmap_bundle')));
  }

  async function startCapture() {
    const seconds = Math.max(1, Math.min(20, parseInt(document.getElementById('seconds').value || '10', 10)));
    document.getElementById('seconds').value = seconds;
    raw.textContent = JSON.stringify(await getJson(qs('start')), null, 2);
    setState('starting...', null);
    setTimeout(pollBundle, 800);
  }

  async function stopCapture() {
    raw.textContent = JSON.stringify(await getJson(qs('stop')), null, 2);
    setTimeout(pollBundle, 400);
  }

  async function resetCapture() {
    raw.textContent = JSON.stringify(await getJson(qs('reset')), null, 2);
    setTimeout(pollBundle, 400);
  }

  document.getElementById('start').addEventListener('click', startCapture);
  document.getElementById('stop').addEventListener('click', stopCapture);
  document.getElementById('reset').addEventListener('click', resetCapture);

  setInterval(pollBundle, 1200);
  pollBundle();
})();
</script>
</body>
</html>
HTML
