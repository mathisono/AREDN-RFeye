#!/bin/sh
# rfeye-agent: status/start/stop/snapshot with strict /tmp capture limits

set -u

STATE_DIR="/tmp/rfeye"
PID_FILE="$STATE_DIR/capture.pid"
END_FILE="$STATE_DIR/capture.end"
CAPTURE_FILE="$STATE_DIR/latest.tlv"
CAPTURE_TMP="$STATE_DIR/latest.tlv.tmp"
BYTES_FILE="$STATE_DIR/capture.bytes"
CFG_FILE="/etc/config/rfeye"

DEFAULT_PHY="phy0"
DEFAULT_MODE="background"
DEFAULT_BINS=128
DEFAULT_MAX_RUNTIME=20
DEFAULT_MAX_CAPTURE_BYTES=262144
DEFAULT_SNAPSHOT_BYTES=32768

mkdir -p "$STATE_DIR"

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

cfg_get() {
  local key="$1" default="$2"
  if command -v uci >/dev/null 2>&1; then
    local v
    v="$(uci -q get rfeye.main.$key 2>/dev/null || true)"
    [ -n "$v" ] && { echo "$v"; return 0; }
  fi
  echo "$default"
}

now_s() { date +%s; }

file_size() { [ -f "$1" ] && wc -c < "$1" 2>/dev/null | awk '{print int($1)}' || echo 0; }

resolve_phy() {
  local phy
  phy="$(cfg_get phy "$DEFAULT_PHY")"
  if [ "$phy" = "auto" ] || [ -z "$phy" ]; then
    for p in /sys/kernel/debug/ieee80211/phy*; do
      [ -d "$p" ] || continue
      basename "$p"
      return 0
    done
    echo "$DEFAULT_PHY"
    return 0
  fi
  echo "$phy"
}

resolve_iface() {
  local phy="${1:-$(resolve_phy)}" iface
  for n in /sys/class/ieee80211/$phy/device/net/*; do
    [ -e "$n" ] || continue
    iface="$(basename "$n")"
    [ -n "$iface" ] && { echo "$iface"; return 0; }
  done
  if command -v iw >/dev/null 2>&1; then
    iw dev 2>/dev/null | awk '/Interface / {print $2; exit}'
  fi
}

channel_from_freq() {
  local f="$1"
  [ "$f" -gt 0 ] 2>/dev/null || { echo 0; return 0; }
  if [ "$f" -eq 2484 ] 2>/dev/null; then echo 14; return 0; fi
  if [ "$f" -ge 2412 ] && [ "$f" -le 2472 ] 2>/dev/null; then echo $(( (f - 2407) / 5 )); return 0; fi
  if [ "$f" -ge 5000 ] && [ "$f" -le 5900 ] 2>/dev/null; then echo $(( (f - 5000) / 5 )); return 0; fi
  if [ "$f" -ge 5955 ] && [ "$f" -le 7115 ] 2>/dev/null; then echo $(( (f - 5950) / 5 )); return 0; fi
  echo 0
}

width_from_text() {
  sed -n 's/.*width:[[:space:]]*\([0-9][0-9]*\).*/\1/p; s/.*channel width:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1
}

radio_info_cmd() {
  local phy iface src info freq=0 chan=0 width=0 ssid="" mode="" raw iwinfo_out cfgfreq cfgchan cfgwidth cfgssid cfgmode
  phy="$(resolve_phy)"
  iface="$(resolve_iface "$phy")"
  [ -n "$iface" ] || { echo "{\"ok\":false,\"error\":\"wireless interface unavailable\",\"phy\":\"$(json_escape "$phy")\"}"; return 1; }

  if command -v iw >/dev/null 2>&1; then
    info="$(iw dev "$iface" info 2>/dev/null || true)"
    if [ -n "$info" ]; then
      src="iw dev $iface info"
      freq="$(printf '%s\n' "$info" | awk '/channel [0-9]+ \(/ {gsub(/[()]/,"",$3); print $3; exit} /freq:/ {print $2; exit}')"
      chan="$(printf '%s\n' "$info" | awk '/channel [0-9]+ / {print $2; exit}')"
      width="$(printf '%s\n' "$info" | width_from_text)"
      ssid="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*ssid[[:space:]]\+//p; s/^[[:space:]]*mesh id[[:space:]]\+//p' | head -n1)"
      mode="$(printf '%s\n' "$info" | awk '/^[[:space:]]*type / {print $2; exit}')"
    fi
    if { [ -z "$freq" ] || [ "$freq" = 0 ]; } && raw="$(iw dev "$iface" survey dump 2>/dev/null || true)" && [ -n "$raw" ]; then
      src="iw dev $iface survey dump"
      freq="$(printf '%s\n' "$raw" | awk '/in use/ {print $2; exit}')"
    fi
  fi

  if { [ -z "$freq" ] || [ "$freq" = 0 ]; } && command -v iwinfo >/dev/null 2>&1; then
    iwinfo_out="$(iwinfo "$iface" info 2>/dev/null || true)"
    if [ -n "$iwinfo_out" ]; then
      src="iwinfo $iface info"
      freq="$(printf '%s\n' "$iwinfo_out" | sed -n 's/.*Frequency:[[:space:]]*\([0-9.]*\)[[:space:]]*GHz.*/\1/p' | awk '{printf "%d\n", ($1 * 1000) + 0.5; exit}')"
      chan="$(printf '%s\n' "$iwinfo_out" | sed -n 's/.*Channel:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)"
      mode="$(printf '%s\n' "$iwinfo_out" | sed -n 's/.*Mode:[[:space:]]*\([^ ]*\).*/\1/p' | head -n1)"
      ssid="$(printf '%s\n' "$iwinfo_out" | sed -n 's/.*ESSID:[[:space:]]*"\(.*\)".*/\1/p' | head -n1)"
    fi
  fi

  if { [ -z "$freq" ] || [ "$freq" = 0 ]; } && command -v uci >/dev/null 2>&1; then
    src="/etc/config/wireless"
    cfgfreq="$(uci -q get wireless.radio0.frequency 2>/dev/null || true)"
    cfgchan="$(uci -q get wireless.radio0.channel 2>/dev/null || true)"
    cfgwidth="$(uci -q get wireless.radio0.htmode 2>/dev/null | sed 's/[^0-9]//g' || true)"
    cfgssid="$(uci -q get wireless.@wifi-iface[0].ssid 2>/dev/null || true)"
    cfgmode="$(uci -q get wireless.@wifi-iface[0].mode 2>/dev/null || true)"
    freq="$cfgfreq"; chan="$cfgchan"; width="$cfgwidth"; ssid="$cfgssid"; mode="$cfgmode"
  fi

  [ -n "$freq" ] || freq=0
  [ -n "$chan" ] || chan="$(channel_from_freq "$freq")"
  [ -n "$width" ] || width=0
  case "$mode" in IBSS|ibss|adhoc|Ad-Hoc) mode="IBSS" ;; managed) mode="managed" ;; monitor) mode="monitor" ;; AP|ap) mode="AP" ;; esac
  if [ "$freq" -lt 2300 ] || [ "$freq" -gt 7100 ] 2>/dev/null; then
    echo "{\"ok\":false,\"error\":\"radio frequency unavailable or implausible\",\"phy\":\"$(json_escape "$phy")\",\"iface\":\"$(json_escape "$iface")\",\"frequency_mhz\":$freq,\"source\":\"$(json_escape "${src:-unavailable}")\"}"
    return 1
  fi
  cat <<JSON
{"ok":true,"phy":"$(json_escape "$phy")","iface":"$(json_escape "$iface")","channel":$chan,"frequency_mhz":$freq,"width_mhz":$width,"ssid_or_ibss":"$(json_escape "$ssid")","mode":"$(json_escape "$mode")","source":"$(json_escape "${src:-unknown}")"}
JSON
}

ath_dir() { echo "/sys/kernel/debug/ieee80211/$1/ath10k"; }

scan_disable() {
  local phy="$1" ctl="$(ath_dir "$phy")/spectral_scan_ctl"
  [ -f "$ctl" ] && echo disable > "$ctl" 2>/dev/null || true
}

running_pid() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

finalize_tmp() {
  if [ -f "$CAPTURE_TMP" ]; then
    file_size "$CAPTURE_TMP" > "$BYTES_FILE" 2>/dev/null || true
    mv -f "$CAPTURE_TMP" "$CAPTURE_FILE" 2>/dev/null || true
  elif [ -f "$CAPTURE_FILE" ]; then
    file_size "$CAPTURE_FILE" > "$BYTES_FILE" 2>/dev/null || true
  fi
}

cleanup_stale() {
  if ! running_pid; then
    finalize_tmp
    rm -f "$PID_FILE" "$END_FILE"
  fi
}

expire_capture_if_needed() {
  local phy now end pid
  running_pid || return 0
  [ -f "$END_FILE" ] || return 0
  now="$(now_s)"
  end="$(cat "$END_FILE" 2>/dev/null || echo 0)"
  [ "$end" -gt 0 ] 2>/dev/null || return 0
  [ "$now" -lt "$end" ] && return 0
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
  sleep 1
  [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
  phy="$(resolve_phy)"
  finalize_tmp
  scan_disable "$phy"
  rm -f "$PID_FILE" "$END_FILE"
}

capture_status_cmd() {
  expire_capture_if_needed
  cleanup_stale
  local running="false" now end exists="false" bytes tmp_bytes
  running_pid && running="true"
  now="$(now_s)"
  end="$(cat "$END_FILE" 2>/dev/null || echo 0)"
  [ -f "$CAPTURE_FILE" ] && exists="true"
  bytes="$(file_size "$CAPTURE_FILE")"
  tmp_bytes="$(file_size "$CAPTURE_TMP")"
  [ "$bytes" -gt 0 ] 2>/dev/null || bytes="$(cat "$BYTES_FILE" 2>/dev/null || echo 0)"
  cat <<JSON
{
  "ok": true,
  "running": $running,
  "latest_capture": "$CAPTURE_FILE",
  "latest_capture_exists": $exists,
  "latest_capture_bytes": $bytes,
  "tmp_capture_bytes": $tmp_bytes,
  "capture_end": $end,
  "now": $now
}
JSON
}

status_cmd() {
  cleanup_stale
  local phy ath ctl scan0 binsf countf parser iface now end running="false" exists="false" bytes
  phy="$(resolve_phy)"
  ath="$(ath_dir "$phy")"
  ctl="$ath/spectral_scan_ctl"
  scan0="$ath/spectral_scan0"
  binsf="$ath/spectral_bins"
  countf="$ath/spectral_count"
  parser="/usr/lib/rfeye/rfeye-spectral-parse"

  iface=""
  for n in /sys/class/ieee80211/$phy/device/net/*; do
    [ -e "$n" ] || continue
    iface="$(basename "$n")"; break
  done

  running_pid && running="true"
  [ -f "$CAPTURE_FILE" ] && exists="true"
  bytes="$(file_size "$CAPTURE_FILE")"
  now="$(now_s)"
  end="$(cat "$END_FILE" 2>/dev/null || echo 0)"

  echo "{"
  echo "  \"ok\": true,"
  echo "  \"phy\": \"$(json_escape "$phy")\","
  echo "  \"running\": $running,"
  echo "  \"now\": $now,"
  echo "  \"capture_end\": $end,"
  echo "  \"limits\": {"
  echo "    \"max_runtime_seconds\": $(cfg_get max_runtime_seconds "$DEFAULT_MAX_RUNTIME"),"
  echo "    \"max_capture_bytes\": $(cfg_get max_capture_bytes "$DEFAULT_MAX_CAPTURE_BYTES"),"
  echo "    \"snapshot_bytes\": $(cfg_get snapshot_bytes "$DEFAULT_SNAPSHOT_BYTES")"
  echo "  },"
  echo "  \"paths\": {"
  echo "    \"spectral_scan_ctl\": $( [ -f "$ctl" ] && echo true || echo false ),"
  echo "    \"spectral_scan0\": $( [ -f "$scan0" ] && echo true || echo false ),"
  echo "    \"spectral_bins\": $( [ -f "$binsf" ] && echo true || echo false ),"
  echo "    \"spectral_count\": $( [ -f "$countf" ] && echo true || echo false ),"
  echo "    \"parser\": $( [ -x "$parser" ] && echo true || echo false )"
  echo "  },"
  echo "  \"iface\": \"$(json_escape "$iface")\","
  echo "  \"latest_capture\": \"$CAPTURE_FILE\","
  echo "  \"latest_capture_exists\": $exists,"
  echo "  \"latest_capture_bytes\": $bytes"
  echo "}"
}

capture_worker() {
  local phy="$1" seconds="$2" bins="$3" max_bytes="$4"
  local ath ctl scan0 binsf mode iface
  ath="$(ath_dir "$phy")"
  ctl="$ath/spectral_scan_ctl"
  scan0="$ath/spectral_scan0"
  binsf="$ath/spectral_bins"
  mode="$(cfg_get scan_mode "$DEFAULT_MODE")"

  finish_worker() {
    finalize_tmp
    scan_disable "$phy"
    rm -f "$PID_FILE" "$END_FILE"
  }
  trap 'finish_worker; exit 0' INT TERM HUP EXIT

  if [ ! -f "$scan0" ] || [ ! -f "$ctl" ]; then
    echo "rfeye-agent: spectral files missing for $phy" >&2
    exit 1
  fi

  case "$bins" in 64|128|256) ;; *) bins="$DEFAULT_BINS" ;; esac

  mkdir -p "$STATE_DIR"
  rm -f "$CAPTURE_TMP" "$CAPTURE_FILE"
  echo 0 > "$BYTES_FILE" 2>/dev/null || true

  [ -f "$binsf" ] && echo "$bins" > "$binsf" 2>/dev/null || true
  echo "$mode" > "$ctl" 2>/dev/null || true
  echo trigger > "$ctl" 2>/dev/null || true

  iface=""
  for n in /sys/class/ieee80211/$phy/device/net/*; do
    [ -e "$n" ] || continue
    iface="$(basename "$n")"; break
  done
  [ -n "$iface" ] && command -v iw >/dev/null 2>&1 && iw dev "$iface" scan >/dev/null 2>&1 || true

  # BusyBox/coreutils timeout behavior against debugfs can vary on small
  # nodes. Run dd directly, then enforce the wall-clock bound ourselves.
  dd if="$scan0" of="$CAPTURE_TMP" bs=1 count="$max_bytes" 2>/dev/null &
  local dd_pid=$! end_ts now
  end_ts=$(( $(now_s) + seconds ))
  while kill -0 "$dd_pid" 2>/dev/null; do
    now="$(now_s)"
    [ "$now" -ge "$end_ts" ] && break
    sleep 1
  done
  if kill -0 "$dd_pid" 2>/dev/null; then
    kill "$dd_pid" 2>/dev/null || true
    sleep 1
    kill -9 "$dd_pid" 2>/dev/null || true
  fi
  wait "$dd_pid" 2>/dev/null || true

  finish_worker
  trap - INT TERM HUP EXIT
}

start_cmd() {
  cleanup_stale
  if running_pid; then
    echo '{"ok":false,"error":"capture already running"}'
    return 1
  fi

  local req_seconds="${1:-$(cfg_get max_runtime_seconds "$DEFAULT_MAX_RUNTIME")}" 
  local req_bins="${2:-$(cfg_get bins "$DEFAULT_BINS")}" 
  local phy="${3:-$(resolve_phy)}"
  local max_runtime max_bytes seconds
  max_runtime="$(cfg_get max_runtime_seconds "$DEFAULT_MAX_RUNTIME")"
  max_bytes="$(cfg_get max_capture_bytes "$DEFAULT_MAX_CAPTURE_BYTES")"

  [ "$req_seconds" -gt 0 ] 2>/dev/null || req_seconds=1
  [ "$max_runtime" -gt 0 ] 2>/dev/null || max_runtime="$DEFAULT_MAX_RUNTIME"
  [ "$max_bytes" -gt 1023 ] 2>/dev/null || max_bytes="$DEFAULT_MAX_CAPTURE_BYTES"

  seconds="$req_seconds"
  [ "$seconds" -gt "$max_runtime" ] && seconds="$max_runtime"

  mkdir -p "$STATE_DIR"
  rm -f "$CAPTURE_TMP" "$CAPTURE_FILE"
  echo 0 > "$BYTES_FILE" 2>/dev/null || true

  ( capture_worker "$phy" "$seconds" "$req_bins" "$max_bytes" ) &
  local pid=$!
  echo "$pid" > "$PID_FILE"
  echo $(( $(now_s) + seconds )) > "$END_FILE"

  echo "{\"ok\":true,\"running\":true,\"pid\":$pid,\"seconds\":$seconds,\"bins\":$req_bins,\"phy\":\"$(json_escape "$phy")\",\"max_capture_bytes\":$max_bytes,\"latest_capture\":\"$CAPTURE_FILE\"}"
}

stop_cmd() {
  local phy bytes
  phy="$(resolve_phy)"
  if running_pid; then
    local pid
    pid="$(cat "$PID_FILE")"
    kill "$pid" 2>/dev/null || true
    sleep 1
    kill -9 "$pid" 2>/dev/null || true
  fi
  finalize_tmp
  scan_disable "$phy"
  rm -f "$PID_FILE" "$END_FILE"
  bytes="$(file_size "$CAPTURE_FILE")"
  echo "{\"ok\":true,\"running\":false,\"latest_capture\":\"$CAPTURE_FILE\",\"latest_capture_exists\":$( [ -f "$CAPTURE_FILE" ] && echo true || echo false ),\"latest_capture_bytes\":$bytes}"
}

snapshot_cmd() {
  local phy="$(resolve_phy)" snap_bytes parser radio_json
  parser="/usr/lib/rfeye/rfeye-spectral-parse"
  radio_json="$(radio_info_cmd 2>/dev/null || echo '{"ok":false,"error":"radio info unavailable"}')"
  snap_bytes="$(cfg_get snapshot_bytes "$DEFAULT_SNAPSHOT_BYTES")"
  [ "$snap_bytes" -gt 0 ] 2>/dev/null || snap_bytes="$DEFAULT_SNAPSHOT_BYTES"
  [ "$snap_bytes" -gt "$DEFAULT_MAX_CAPTURE_BYTES" ] && snap_bytes="$DEFAULT_MAX_CAPTURE_BYTES"

  local ath scan0 ctl tmp scan0_exists="false" ctl_exists="false" parser_exists="false" bytes_read=0 parser_out frame tries
  ath="$(ath_dir "$phy")"
  scan0="$ath/spectral_scan0"
  ctl="$ath/spectral_scan_ctl"
  tmp="$STATE_DIR/snapshot.bin"
  [ -f "$scan0" ] && scan0_exists="true"
  [ -f "$ctl" ] && ctl_exists="true"
  [ -x "$parser" ] && parser_exists="true"

  if [ ! -f "$scan0" ] || [ ! -x "$parser" ]; then
    echo "{\"ok\":false,\"error\":\"unsupported\",\"phy\":\"$(json_escape "$phy")\",\"radio\":$radio_json,\"scan0_exists\":$scan0_exists,\"ctl_exists\":$ctl_exists,\"parser_exists\":$parser_exists,\"bytes_read\":0,\"parser_output_present\":false}"
    return 1
  fi

  frame=""
  parser_out=""
  bytes_read=0
  tries=0
  while [ "$tries" -lt 3 ]; do
    tries=$((tries + 1))
    [ -f "$ctl" ] && echo background > "$ctl" 2>/dev/null || true
    [ -f "$ctl" ] && echo trigger > "$ctl" 2>/dev/null || true
    dd if="$scan0" of="$tmp" bs=1 count="$snap_bytes" 2>/dev/null || true
    [ -f "$ctl" ] && echo disable > "$ctl" 2>/dev/null || true
    bytes_read="$(file_size "$tmp")"
    parser_out="$($parser --input "$tmp" --phy "$phy" --limit 1 --bins 128 2>/dev/null | head -n1)"
    frame="$parser_out"
    [ -n "$frame" ] && break
    sleep 1
  done
  rm -f "$tmp"

  if [ -z "$frame" ]; then
    echo "{\"ok\":false,\"error\":\"no frame\",\"phy\":\"$(json_escape "$phy")\",\"radio\":$radio_json,\"scan0_exists\":$scan0_exists,\"ctl_exists\":$ctl_exists,\"parser_exists\":$parser_exists,\"bytes_read\":$bytes_read,\"parser_output_present\":false,\"tries\":$tries}"
    return 1
  fi

  echo "{\"ok\":true,\"radio\":$radio_json,\"frame\":$frame,\"diagnostics\":{\"scan0_exists\":$scan0_exists,\"ctl_exists\":$ctl_exists,\"parser_exists\":$parser_exists,\"bytes_read\":$bytes_read,\"parser_output_present\":true,\"tries\":$tries}}"
}

daemon_cmd() {
  while true; do
    if running_pid && [ -f "$END_FILE" ]; then
      local now end
      now="$(now_s)"
      end="$(cat "$END_FILE" 2>/dev/null || echo 0)"
      if [ "$end" -gt 0 ] && [ "$now" -ge "$end" ]; then
        stop_cmd >/dev/null 2>&1 || true
      fi
    fi
    sleep 2
  done
}

cmd="${1:-status}"
shift || true

case "$cmd" in
  status) status_cmd ;;
  capture_status) capture_status_cmd ;;
  radio_info) radio_info_cmd ;;
  start) start_cmd "$@" ;;
  stop) stop_cmd ;;
  snapshot) snapshot_cmd ;;
  daemon) daemon_cmd ;;
  *)
    echo '{"ok":false,"error":"usage: rfeye-agent {status|capture_status|radio_info|start [seconds bins phy]|stop|snapshot|daemon}"}'
    exit 2
    ;;
esac
