#!/bin/sh
# rfeye-agent: reliable capture cadence + heatmap bundle endpoints (all state in /tmp/rfeye)

set -u

STATE_DIR="/tmp/rfeye"
PID_FILE="$STATE_DIR/capture.pid"
END_FILE="$STATE_DIR/capture.end"
CAPTURE_FILE="$STATE_DIR/latest.tlv"
CAPTURE_TMP="$STATE_DIR/latest.tlv.tmp"
BYTES_FILE="$STATE_DIR/capture.bytes"
CFG_FILE="/etc/config/rfeye"

SESSION_FILE="$STATE_DIR/session.json"
RADIO_FILE="$STATE_DIR/radio.json"
WAVEFORM_FILE="$STATE_DIR/waveform.json"
WATERFALL_FILE="$STATE_DIR/waterfall.ndjson"
AMBIENT_FILE="$STATE_DIR/ambient.ndjson"
AMBIENT_WORK_FILE="$STATE_DIR/ambient.work"
RING_FILE="$STATE_DIR/frame_ring.ndjson"
FRAME_FILE="$STATE_DIR/latest_frame.json"
FRAME_RAW_FILE="$STATE_DIR/latest_parser_frame.json"
BUNDLE_FILE="$STATE_DIR/heatmap_bundle.json"
LOCK_DIR="$STATE_DIR/capture.lock"
DEBUG_LAST_CYCLE="$STATE_DIR/debug-last-cycle.tlv"
DEBUG_LAST_PARSER="$STATE_DIR/debug-last-parser.txt"
DEBUG_LAST_STATS="$STATE_DIR/debug-last-stats.json"
RAW_TEST_FILE="$STATE_DIR/raw-test.tlv"
RAW_TEST_STATS="$STATE_DIR/raw-test-stats.json"
PIPELINE_STATUS_FILE="$STATE_DIR/pipeline-status.json"

DEFAULT_PHY="phy0"
DEFAULT_MODE="background"
DEFAULT_BINS=128
DEFAULT_UI_BINS=128
DEFAULT_MAX_RUNTIME=20
DEFAULT_MAX_CAPTURE_BYTES=262144
DEFAULT_SNAPSHOT_BYTES=65536
DEFAULT_SAMPLE_INTERVAL_MS=2000
DEFAULT_WATERFALL_ROWS=64
DEFAULT_AMBIENT_ROWS=60
DEFAULT_RING_FRAMES=256
DEFAULT_MIN_DBM=-125
DEFAULT_MAX_DBM=-65

mkdir -p "$STATE_DIR"

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

cfg_get() {
  local key="$1" default="$2"
  if command -v uci >/dev/null 2>&1; then
    local v
    v="$(uci -q get rfeye.main.$key 2>/dev/null || true)"
    [ -n "$v" ] && { echo "$v"; return 0; }
  fi
  echo "$default"
}

now_s() { date +%s; }
file_size() { [ -f "$1" ] && wc -c < "$1" 2>/dev/null | awk '{print int($1)}' || echo 0; }

resolve_phy() {
  local phy
  phy="$(cfg_get phy "$DEFAULT_PHY")"
  if [ "$phy" = "auto" ] || [ -z "$phy" ]; then
    for p in /sys/kernel/debug/ieee80211/phy*; do
      [ -d "$p" ] || continue
      basename "$p"
      return 0
    done
    echo "$DEFAULT_PHY"
    return 0
  fi
  echo "$phy"
}

resolve_iface() {
  local phy="${1:-$(resolve_phy)}" iface
  for n in /sys/class/ieee80211/$phy/device/net/*; do
    [ -e "$n" ] || continue
    iface="$(basename "$n")"
    [ -n "$iface" ] && { echo "$iface"; return 0; }
  done
  if command -v iw >/dev/null 2>&1; then
    iw dev 2>/dev/null | awk '/Interface / {print $2; exit}'
  fi
}

channel_from_freq() {
  local f="$1"
  [ "$f" -gt 0 ] 2>/dev/null || { echo 0; return 0; }
  if [ "$f" -eq 2484 ] 2>/dev/null; then echo 14; return 0; fi
  if [ "$f" -ge 2412 ] && [ "$f" -le 2472 ] 2>/dev/null; then echo $(( (f - 2407) / 5 )); return 0; fi
  if [ "$f" -ge 5000 ] && [ "$f" -le 5900 ] 2>/dev/null; then echo $(( (f - 5000) / 5 )); return 0; fi
  if [ "$f" -ge 5955 ] && [ "$f" -le 7115 ] 2>/dev/null; then echo $(( (f - 5950) / 5 )); return 0; fi
  echo 0
}

width_from_text() {
  sed -n 's/.*width:[[:space:]]*\([0-9][0-9]*\).*/\1/p; s/.*channel width:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1
}

radio_info_cmd() {
  local phy iface src info freq=0 chan=0 width=0 ssid="" mode="" raw iwinfo_out cfgfreq cfgchan cfgwidth cfgssid cfgmode
  phy="$(resolve_phy)"
  iface="$(resolve_iface "$phy")"
  [ -n "$iface" ] || { echo "{\"ok\":false,\"error\":\"wireless interface unavailable\",\"phy\":\"$(json_escape "$phy")\"}"; return 1; }

  if command -v iw >/dev/null 2>&1; then
    info="$(iw dev "$iface" info 2>/dev/null || true)"
    if [ -n "$info" ]; then
      src="iw dev $iface info"
      freq="$(printf '%s\n' "$info" | awk '/channel [0-9]+ \(/ {gsub(/[()]/,"",$3); print $3; exit} /freq:/ {print $2; exit}')"
      chan="$(printf '%s\n' "$info" | awk '/channel [0-9]+ / {print $2; exit}')"
      width="$(printf '%s\n' "$info" | width_from_text)"
      ssid="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*ssid[[:space:]]\+//p; s/^[[:space:]]*mesh id[[:space:]]\+//p' | head -n1)"
      mode="$(printf '%s\n' "$info" | awk '/^[[:space:]]*type / {print $2; exit}')"
    fi
    if { [ -z "$freq" ] || [ "$freq" = 0 ]; } && raw="$(iw dev "$iface" survey dump 2>/dev/null || true)" && [ -n "$raw" ]; then
      src="iw dev $iface survey dump"
      freq="$(printf '%s\n' "$raw" | awk '/in use/ {print $2; exit}')"
    fi
  fi

  if { [ -z "$freq" ] || [ "$freq" = 0 ]; } && command -v iwinfo >/dev/null 2>&1; then
    iwinfo_out="$(iwinfo "$iface" info 2>/dev/null || true)"
    if [ -n "$iwinfo_out" ]; then
      src="iwinfo $iface info"
      freq="$(printf '%s\n' "$iwinfo_out" | sed -n 's/.*Frequency:[[:space:]]*\([0-9.]*\)[[:space:]]*GHz.*/\1/p' | awk '{printf "%d\n", ($1 * 1000) + 0.5; exit}')"
      chan="$(printf '%s\n' "$iwinfo_out" | sed -n 's/.*Channel:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)"
      mode="$(printf '%s\n' "$iwinfo_out" | sed -n 's/.*Mode:[[:space:]]*\([^ ]*\).*/\1/p' | head -n1)"
      ssid="$(printf '%s\n' "$iwinfo_out" | sed -n 's/.*ESSID:[[:space:]]*"\(.*\)".*/\1/p' | head -n1)"
    fi
  fi

  if { [ -z "$freq" ] || [ "$freq" = 0 ]; } && command -v uci >/dev/null 2>&1; then
    src="/etc/config/wireless"
    cfgfreq="$(uci -q get wireless.radio0.frequency 2>/dev/null || true)"
    cfgchan="$(uci -q get wireless.radio0.channel 2>/dev/null || true)"
    cfgwidth="$(uci -q get wireless.radio0.htmode 2>/dev/null | sed 's/[^0-9]//g' || true)"
    cfgssid="$(uci -q get wireless.@wifi-iface[0].ssid 2>/dev/null || true)"
    cfgmode="$(uci -q get wireless.@wifi-iface[0].mode 2>/dev/null || true)"
    freq="$cfgfreq"; chan="$cfgchan"; width="$cfgwidth"; ssid="$cfgssid"; mode="$cfgmode"
  fi

  [ -n "$freq" ] || freq=0
  [ -n "$chan" ] || chan="$(channel_from_freq "$freq")"
  [ -n "$width" ] || width=0
  case "$mode" in IBSS|ibss|adhoc|Ad-Hoc) mode="IBSS" ;; managed) mode="managed" ;; monitor) mode="monitor" ;; AP|ap) mode="AP" ;; esac
  if [ "$freq" -lt 2300 ] || [ "$freq" -gt 7100 ] 2>/dev/null; then
    echo "{\"ok\":false,\"error\":\"radio frequency unavailable or implausible\",\"phy\":\"$(json_escape "$phy")\",\"iface\":\"$(json_escape "$iface")\",\"frequency_mhz\":$freq,\"source\":\"$(json_escape "${src:-unavailable}")\"}"
    return 1
  fi
  cat <<JSON
{"ok":true,"phy":"$(json_escape "$phy")","iface":"$(json_escape "$iface")","channel":$chan,"frequency_mhz":$freq,"width_mhz":$width,"ssid_or_ibss":"$(json_escape "$ssid")","mode":"$(json_escape "$mode")","source":"$(json_escape "${src:-unknown}")"}
JSON
}

ath_dir() { echo "/sys/kernel/debug/ieee80211/$1/ath10k"; }
scan_disable() {
  local phy="$1" ctl="$(ath_dir "$phy")/spectral_scan_ctl"
  [ -f "$ctl" ] && echo disable > "$ctl" 2>/dev/null || true
}
short_sleep() { sleep 0.2 2>/dev/null || sleep 1; }
spectral_ctl_value() {
  local phy="$1" ctl="$(ath_dir "$phy")/spectral_scan_ctl"
  [ -f "$ctl" ] && cat "$ctl" 2>/dev/null || echo "unavailable"
}

spectral_reset_phy() {
  local phy="$1" bins="${2:-$DEFAULT_BINS}" ath ctl binsf mode
  ath="$(ath_dir "$phy")"
  ctl="$ath/spectral_scan_ctl"
  binsf="$ath/spectral_bins"
  mode="$(cfg_get scan_mode "$DEFAULT_MODE")"
  case "$bins" in 64|128|256) ;; *) bins="$DEFAULT_BINS" ;; esac
  [ -f "$ctl" ] || return 1
  echo disable > "$ctl" 2>/dev/null || true
  short_sleep
  [ -f "$binsf" ] && echo "$bins" > "$binsf" 2>/dev/null || true
  echo "$mode" > "$ctl" 2>/dev/null || true
  echo trigger > "$ctl" 2>/dev/null || true
}

running_pid() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

append_capped() {
  local file="$1" line="$2" max="${3:-64}" tmp
  [ "$max" -gt 1 ] 2>/dev/null || max=2
  tmp="$file.tmp"
  {
    [ -f "$file" ] && tail -n $((max - 1)) "$file" 2>/dev/null || true
    printf '%s\n' "$line"
  } > "$tmp"
  mv -f "$tmp" "$file"
}

json_array_from_lines() {
  local file="$1"
  if [ ! -s "$file" ]; then
    echo "[]"
    return 0
  fi
  awk 'BEGIN{printf "["} NF{if(n++)printf ","; printf "%s", $0} END{printf "]"}' "$file"
}

extract_json_number() {
  local json="$1" key="$2" v
  v="$(printf '%s\n' "$json" | sed -n "s/.*\"$key\":\(-\{0,1\}[0-9][0-9]*\).*/\1/p" | head -n1)"
  [ -n "$v" ] && echo "$v" || echo 0
}

extract_json_bool() {
  local json="$1" key="$2" v
  v="$(printf '%s\n' "$json" | sed -n "s/.*\"$key\":\(true\|false\).*/\1/p" | head -n1)"
  [ -n "$v" ] && echo "$v" || echo false
}

extract_bins_csv() {
  printf '%s\n' "$1" | sed -n 's/.*"bins":\[\(.*\)\].*/\1/p' | head -n1
}

normalize_bins_dbm_csv() {
  local bins_csv="$1" out_bins="$2" noise="$3" min_dbm="$4" max_dbm="$5"
  awk -v bins="$bins_csv" -v out="$out_bins" -v noise="$noise" -v minv="$min_dbm" -v maxv="$max_dbm" '
    BEGIN {
      n=split(bins,a,",");
      if(n<1 || out<1){print ""; exit}
      if(noise==0) noise=-95
      for(i=1;i<=out;i++){
        s=int((i-1)*n/out)+1;
        e=int(i*n/out);
        if(e<s)e=s;
        m=-1;
        for(j=s;j<=e && j<=n;j++){
          v=a[j]+0;
          if(v>m)m=v;
        }
        if(m<0)m=0;
        db=noise + (m/255.0)*50.0;
        if(db<minv) db=minv;
        if(db>maxv) db=maxv;
        iv=int(db+0.5);
        printf("%s%d", (i==1?"":","), iv);
      }
      printf("\n");
    }
  '
}

csv_peak() {
  local a="$1" b="$2"
  awk -v A="$a" -v B="$b" 'BEGIN{
    na=split(A,a,","); nb=split(B,b,","); n=(na>nb?na:nb);
    for(i=1;i<=n;i++){
      va=(i<=na?a[i]+0:-9999); vb=(i<=nb?b[i]+0:-9999);
      m=(va>vb?va:vb);
      if(m<-9000)m=0;
      printf("%s%d", (i==1?"":","), int(m));
    }
    printf("\n");
  }'
}

sleep_interval_ms() {
  local ms="$1" sec
  [ "$ms" -gt 0 ] 2>/dev/null || ms="$DEFAULT_SAMPLE_INTERVAL_MS"
  if [ "$ms" -lt 1000 ] 2>/dev/null; then ms=1000; fi
  sec=$(( (ms + 999) / 1000 ))
  [ "$sec" -gt 0 ] 2>/dev/null || sec=1
  echo "$sec"
}

acquire_lock() {
  local tries=0
  while [ "$tries" -lt 20 ]; do
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      return 0
    fi
    tries=$((tries + 1))
    short_sleep
  done
  return 1
}

release_lock() { rmdir "$LOCK_DIR" 2>/dev/null || true; }
remove_stale_lock() {
  running_pid || rm -rf "$LOCK_DIR" 2>/dev/null || true
}

write_session() {
  local state="$1" started="$2" ends="$3" frames="$4" bytes="$5" latest="$6" nof="$7" err="${8:-}"
  cat > "$SESSION_FILE" <<JSON
{"state":"$state","started_at":$started,"ends_at":$ends,"frames_captured":$frames,"bytes_written":$bytes,"latest_frame_time":$latest,"no_frame_count":$nof,"error":"$(json_escape "$err")"}
JSON
}

session_num() {
  local key="$1" def="$2" v
  [ -s "$SESSION_FILE" ] || { echo "$def"; return 0; }
  v="$(sed -n "s/.*\"$key\":\(-\{0,1\}[0-9][0-9]*\).*/\1/p" "$SESSION_FILE" | head -n1)"
  [ -n "$v" ] && echo "$v" || echo "$def"
}

session_state() {
  [ -s "$SESSION_FILE" ] || { echo "idle"; return 0; }
  sed -n 's/.*"state":"\([^"]*\)".*/\1/p' "$SESSION_FILE" | head -n1
}

radio_info_safe() {
  local r
  r="$(radio_info_cmd 2>/dev/null || true)"
  [ -n "$r" ] && { printf '%s\n' "$r"; return 0; }
  echo '{"ok":false,"error":"radio info unavailable"}'
}

store_radio() {
  local r
  r="$(radio_info_safe)"
  printf '%s\n' "$r" > "$RADIO_FILE"
}

radio_json() {
  if [ -s "$RADIO_FILE" ]; then cat "$RADIO_FILE"; else radio_info_safe; fi
}

update_ambient() {
  local ts="$1" bins_csv="$2" rows max_rows minute curm curb peak line
  max_rows="$(cfg_get ambient_rows "$DEFAULT_AMBIENT_ROWS")"
  [ "$max_rows" -gt 1 ] 2>/dev/null || max_rows="$DEFAULT_AMBIENT_ROWS"
  minute=$(( ts / 60 ))

  if [ -s "$AMBIENT_WORK_FILE" ]; then
    curm="$(cut -d'|' -f1 "$AMBIENT_WORK_FILE" 2>/dev/null || echo "")"
    curb="$(cut -d'|' -f2- "$AMBIENT_WORK_FILE" 2>/dev/null || echo "")"
  else
    curm=""
    curb=""
  fi

  if [ -z "$curm" ]; then
    printf '%s|%s\n' "$minute" "$bins_csv" > "$AMBIENT_WORK_FILE"
    return 0
  fi

  if [ "$curm" = "$minute" ]; then
    peak="$(csv_peak "$curb" "$bins_csv")"
    printf '%s|%s\n' "$minute" "$peak" > "$AMBIENT_WORK_FILE"
    return 0
  fi

  line="{\"timestamp\":$((curm * 60)),\"bins\":[${curb}]}"
  append_capped "$AMBIENT_FILE" "$line" "$max_rows"
  printf '%s|%s\n' "$minute" "$bins_csv" > "$AMBIENT_WORK_FILE"
}

render_waveform_default() {
  local r freq width x0 x1
  r="$(radio_json)"
  freq="$(extract_json_number "$r" frequency_mhz)"
  width="$(extract_json_number "$r" width_mhz)"
  [ "$width" -gt 0 ] 2>/dev/null || width=20
  x0=$((freq - (width / 2)))
  x1=$((freq + (width / 2)))
  [ "$x0" -gt 0 ] 2>/dev/null || x0=0
  [ "$x1" -gt 0 ] 2>/dev/null || x1=0
  echo "{\"x_start_mhz\":$x0,\"x_end_mhz\":$x1,\"bins\":[]}"
}

ambient_rows_json() {
  local amb_rows cur_line curm curb
  if [ -s "$AMBIENT_WORK_FILE" ]; then
    curm="$(cut -d'|' -f1 "$AMBIENT_WORK_FILE" 2>/dev/null || true)"
    curb="$(cut -d'|' -f2- "$AMBIENT_WORK_FILE" 2>/dev/null || true)"
    if [ -n "$curm" ] && [ -n "$curb" ]; then
      cur_line="{\"timestamp\":$((curm * 60)),\"bins\":[${curb}]}"
      {
        [ -s "$AMBIENT_FILE" ] && cat "$AMBIENT_FILE" || true
        printf '%s\n' "$cur_line"
      } > "$AMBIENT_FILE.tmp"
      amb_rows="$(json_array_from_lines "$AMBIENT_FILE.tmp")"
      rm -f "$AMBIENT_FILE.tmp"
      echo "$amb_rows"
      return 0
    fi
  fi
  json_array_from_lines "$AMBIENT_FILE"
}


count_csv_fields() {
  local csv="$1"
  [ -n "$csv" ] || { echo 0; return 0; }
  awk -v s="$csv" 'BEGIN{print split(s,a,",")}'
}

count_json_rows_file() {
  local file="$1"
  [ -s "$file" ] && awk 'NF{n++} END{print n+0}' "$file" || echo 0
}

pipeline_status_json() {
  if [ -s "$PIPELINE_STATUS_FILE" ]; then
    cat "$PIPELINE_STATUS_FILE"
  else
    echo '{"ok":true,"last_cycle_time":0,"raw_bytes":0,"parser_exit":0,"parser_frame_present":false,"parser_frame_bytes":0,"bins_extracted":false,"normalized_bins_count":0,"waveform_written":false,"waveform_bins":0,"waterfall_rows":0,"ambient_rows":0,"frames_captured":0,"last_error":""}'
  fi
}

ambient_row_count() {
  local n
  n="$(count_json_rows_file "$AMBIENT_FILE")"
  if [ -s "$AMBIENT_WORK_FILE" ]; then
    local curm curb
    curm="$(cut -d'|' -f1 "$AMBIENT_WORK_FILE" 2>/dev/null || true)"
    curb="$(cut -d'|' -f2- "$AMBIENT_WORK_FILE" 2>/dev/null || true)"
    [ -n "$curm" ] && [ -n "$curb" ] && n=$((n + 1))
  fi
  echo "$n"
}

ambient_pending_bool() {
  if [ -s "$AMBIENT_WORK_FILE" ]; then
    local curm curb
    curm="$(cut -d'|' -f1 "$AMBIENT_WORK_FILE" 2>/dev/null || true)"
    curb="$(cut -d'|' -f2- "$AMBIENT_WORK_FILE" 2>/dev/null || true)"
    [ -n "$curm" ] && [ -n "$curb" ] && { echo true; return 0; }
  fi
  echo false
}

ambient_current_json() {
  if [ -s "$AMBIENT_WORK_FILE" ]; then
    local curm curb
    curm="$(cut -d'|' -f1 "$AMBIENT_WORK_FILE" 2>/dev/null || true)"
    curb="$(cut -d'|' -f2- "$AMBIENT_WORK_FILE" 2>/dev/null || true)"
    if [ -n "$curm" ] && [ -n "$curb" ]; then
      echo "{\"timestamp\":$((curm * 60)),\"bins\":[${curb}]}"
      return 0
    fi
  fi
  echo 'null'
}

write_pipeline_status() {
  local raw_bytes="${1:-0}" parser_exit="${2:-0}" frame_present="${3:-false}" frame_bytes="${4:-0}" bins_extracted="${5:-false}" norm_count="${6:-0}" waveform_written="${7:-false}" waveform_bins="${8:-0}" waterfall_rows="${9:-0}"
  shift 9 || true
  local ambient_rows="${1:-0}" frames_captured="${2:-0}" last_error="${3:-}"
  cat > "$PIPELINE_STATUS_FILE" <<JSON
{"ok":true,"last_cycle_time":$(now_s),"raw_bytes":$raw_bytes,"parser_exit":$parser_exit,"parser_frame_present":$frame_present,"parser_frame_bytes":$frame_bytes,"bins_extracted":$bins_extracted,"normalized_bins_count":$norm_count,"waveform_written":$waveform_written,"waveform_bins":$waveform_bins,"waterfall_rows":$waterfall_rows,"ambient_rows":$ambient_rows,"frames_captured":$frames_captured,"last_error":"$(json_escape "$last_error")"}
JSON
}

pipeline_status_cmd() {
  cleanup_stale
  pipeline_status_json
}

write_debug_artifacts() {
  local raw_file="$1" parser_out_file="$2" stats_file="$3" bytes="$4" frames="$5" truncated="$6"
  [ -n "$raw_file" ] && [ -f "$raw_file" ] && cp -f "$raw_file" "$DEBUG_LAST_CYCLE" 2>/dev/null || :
  [ -n "$parser_out_file" ] && [ -f "$parser_out_file" ] && cp -f "$parser_out_file" "$DEBUG_LAST_PARSER" 2>/dev/null || :
  [ -n "$stats_file" ] && [ -f "$stats_file" ] && cp -f "$stats_file" "$DEBUG_LAST_STATS" 2>/dev/null || printf '{"frames_emitted":0,"trailing_truncated":false}\n' > "$DEBUG_LAST_STATS"
  printf '{"latest_cycle_bytes":%s,"latest_capture_bytes":%s,"frames_emitted":%s,"trailing_truncated":%s}\n' "$bytes" "$(file_size "$CAPTURE_FILE")" "$frames" "$truncated" > "$STATE_DIR/acquisition_debug.json"
}

acquisition_debug_json() {
  local latest_cycle_bytes latest_capture_bytes frames_emitted trailing_truncated scan0_exists ctl_exists parser_exists ctl_after files_json
  latest_cycle_bytes="$(file_size "$DEBUG_LAST_CYCLE")"
  latest_capture_bytes="$(file_size "$CAPTURE_FILE")"
  frames_emitted="$(sed -n 's/.*"frames_emitted":\([0-9][0-9]*\).*/\1/p' "$DEBUG_LAST_STATS" 2>/dev/null | head -n1)"
  trailing_truncated="$(sed -n 's/.*"trailing_truncated":\(true\|false\).*/\1/p' "$DEBUG_LAST_STATS" 2>/dev/null | head -n1)"
  [ -n "$frames_emitted" ] || frames_emitted=0
  [ -n "$trailing_truncated" ] || trailing_truncated=false
  local phy ath scan0
  phy="$(resolve_phy)"
  ath="$(ath_dir "$phy")"
  scan0="$ath/spectral_scan0"
  scan0_exists=$( [ -f "$scan0" ] && echo true || echo false )
  ctl_exists=$( [ -f "$ath/spectral_scan_ctl" ] && echo true || echo false )
  parser_exists=$( [ -x /usr/lib/rfeye/rfeye-spectral-parse ] && echo true || echo false )
  ctl_after="$(spectral_ctl_value "$phy")"
  files_json='["/tmp/rfeye/debug-last-cycle.tlv","/tmp/rfeye/debug-last-parser.txt","/tmp/rfeye/debug-last-stats.json","/tmp/rfeye/raw-test.tlv","/tmp/rfeye/raw-test-stats.json"]'
  cat <<JSON
{"ok":true,"latest_cycle_bytes":$latest_cycle_bytes,"latest_capture_bytes":$latest_capture_bytes,"frames_emitted":$frames_emitted,"trailing_truncated":$trailing_truncated,"scan0_exists":$scan0_exists,"ctl_exists":$ctl_exists,"parser_exists":$parser_exists,"spectral_ctl_after":"$(json_escape "$ctl_after")","debug_files":$files_json}
JSON
}

hex_prefix() {
  local file="$1" n="$2"
  [ -f "$file" ] || { echo ""; return 0; }
  hexdump -v -n "$n" -e '1/1 "%02x"' "$file" 2>/dev/null
}

count_bytes() {
  local file="$1"
  [ -f "$file" ] || { echo "0 0"; return 0; }
  hexdump -v -e '1/1 "%u\n"' "$file" 2>/dev/null | awk '{if($1==0)z++; else nz++} END{printf "%d %d\n", z+0, nz+0}'
}

first_nonzero_offset() {
  local file="$1"
  [ -f "$file" ] || { echo -1; return 0; }
  hexdump -v -e '1/1 "%u\n"' "$file" 2>/dev/null | awk 'BEGIN{idx=0; found=0} {if($1+0!=0){print idx; found=1; exit} idx++} END{if(!found) print -1}'
}

byte_histogram_json() {
  local file="$1"
  [ -f "$file" ] || { echo '{}'; return 0; }
  hexdump -v -n 4096 -e '1/1 "%u\n"' "$file" 2>/dev/null | awk '
    { c[sprintf("%02x", $1+0)]++ }
    END{
      printf "{"
      for(i=0;i<256;i++){
        k=sprintf("%02x", i)
        printf "%s\"%s\":%d", (i?",":""), k, c[k]+0
      }
      printf "}"
    }
  '
}

likely_binary_file() {
  local file="$1"
  [ -f "$file" ] || { echo false; return 0; }
  hexdump -v -n 4096 -e '1/1 "%u\n"' "$file" 2>/dev/null | awk '
    { b=$1+0; if(b==0 || b<9 || (b>13 && b<32) || b>126){print "true"; found=1; exit} }
    END{if(!found) print "false"}
  '
}

inspect_file_json() {
  local file="$1" parser_stats="$2" size z nz hex64 hex256 firstnz binary hist
  if [ ! -f "$file" ]; then
    printf '{"path":"%s","exists":false}' "$file"
    return 0
  fi
  size="$(file_size "$file")"
  read z nz <<EOF
$(count_bytes "$file")
EOF
  hex64="$(hex_prefix "$file" 64)"
  hex256="$(hex_prefix "$file" 256)"
  firstnz="$(first_nonzero_offset "$file")"
  binary="$(likely_binary_file "$file")"
  hist="$(byte_histogram_json "$file")"
  printf '{"path":"%s","exists":true,"size_bytes":%s,"first_64_hex":"%s","first_256_hex":"%s","count_zero_bytes":%s,"count_nonzero_bytes":%s,"first_nonzero_offset":%s,"likely_binary":%s,"histogram_first_4096":%s' \
    "$file" "$size" "$hex64" "$hex256" "$z" "$nz" "$firstnz" "$binary" "$hist"
  if [ -n "$parser_stats" ] && [ -s "$parser_stats" ]; then
    printf ',"parser_stats":'
    cat "$parser_stats"
  fi
  printf '}'
}

raw_inspect_cmd() {
  cleanup_stale
  local stats_file
  stats_file=""
  for f in "$RAW_TEST_STATS" "$STATE_DIR/latest_parser_stats.json" "$DEBUG_LAST_STATS"; do
    [ -s "$f" ] && { stats_file="$f"; break; }
  done
  printf '{"ok":true,"files":['
  local first=1 file
  for file in "$RAW_TEST_FILE" "$CAPTURE_FILE" "$DEBUG_LAST_CYCLE"; do
    [ -f "$file" ] || continue
    printf '%s' "$([ "$first" -eq 1 ] && echo '' || echo ',')"
    inspect_file_json "$file" "$stats_file"
    first=0
  done
  printf ']'
  if [ -n "$stats_file" ] && [ -s "$stats_file" ]; then
    printf ',"parser_stats":'
    cat "$stats_file"
  fi
  printf '}\n'
}

parser_probe_cmd() {
  cleanup_stale
  local probe_file resync_stats
  probe_file="$STATE_DIR/parser-probe.json"
  resync_stats="$STATE_DIR/parser-resync-stats.json"
  /usr/lib/rfeye/rfeye-spectral-parse --probe --input "$RAW_TEST_FILE" >"$probe_file" 2>/dev/null || true
  /usr/lib/rfeye/rfeye-spectral-parse --resync --stats --input "$RAW_TEST_FILE" --phy phy0 --limit 1 --bins 64 >/dev/null 2>"$resync_stats" || true
  printf '{"ok":true,"probe":'
  [ -s "$probe_file" ] && cat "$probe_file" || printf '{"ok":false,"error":"probe failed"}'
  printf ',"resync_stats":'
  [ -s "$resync_stats" ] && cat "$resync_stats" || printf '{"frames_emitted":0,"skipped_bytes":0}'
  printf '}\n'
}

capture_cycle_sequence() {
  local phy="$1" bins="$2" snap_bytes="$3" parser="$4" raw_out="$5" parser_out="$6" stats_out="$7" mode="$8" sleep_before="$9" iface ath scan0 tmp stats frame bytes_read frames_emitted truncated parser_exit out_line
  ath="$(ath_dir "$phy")"
  scan0="$ath/spectral_scan0"
  tmp="$STATE_DIR/cycle.$$.bin"
  stats="$STATE_DIR/cycle.$$.stats"
  iface="$(resolve_iface "$phy")"
  frames_emitted=0
  truncated=false
  parser_exit=0

  [ -f "$scan0" ] || return 1
  [ -x "$parser" ] || return 1

  rm -f "$tmp" "$stats" "$raw_out" "$stats_out" "$DEBUG_LAST_CYCLE" "$DEBUG_LAST_PARSER" "$DEBUG_LAST_STATS"
  if [ "$mode" = "known-good" ]; then
    spectral_reset_phy "$phy" "$bins" || true
  fi
  [ -n "$iface" ] && command -v iw >/dev/null 2>&1 && iw dev "$iface" scan >/dev/null 2>&1 || true
  sleep "${sleep_before:-1}"
  dd if="$scan0" of="$tmp" bs=1 count="$snap_bytes" 2>/dev/null || true
  bytes_read="$(file_size "$tmp")"
  scan_disable "$phy"
  mv -f "$tmp" "$raw_out" 2>/dev/null || cp -f "$tmp" "$raw_out" 2>/dev/null || true
  if [ -f "$raw_out" ]; then
    frame="$($parser --resync --input "$raw_out" --phy "$phy" --limit 1 --bins "$bins" 2>/dev/null | head -n1)"
    printf '%s\n' "$frame" > "$parser_out"
    $parser --resync --input "$raw_out" --phy "$phy" --limit 1 --bins "$bins" --stats >/dev/null 2>"$stats_out"
    parser_exit=$?
    if [ -s "$stats_out" ]; then
      frames_emitted="$(sed -n 's/.*"frames_emitted":\([0-9][0-9]*\).*/\1/p' "$stats_out" | head -n1)"
      truncated="$(sed -n 's/.*"trailing_truncated":\(true\|false\).*/\1/p' "$stats_out" | head -n1)"
      [ -n "$frames_emitted" ] || frames_emitted=0
      [ -n "$truncated" ] || truncated=false
    else
      printf '{"frames_emitted":0,"trailing_truncated":false}\n' > "$stats_out"
    fi
    write_debug_artifacts "$raw_out" "$parser_out" "$stats_out" "$bytes_read" "$frames_emitted" "$truncated"
    if [ -n "$frame" ]; then
      printf '%s\n' "$frame"
      return 0
    fi
  fi
  [ -s "$stats_out" ] || printf '{"frames_emitted":0,"trailing_truncated":false}\n' > "$stats_out"
  write_debug_artifacts "$raw_out" "$parser_out" "$stats_out" "$bytes_read" "$frames_emitted" "$truncated"
  return 1
}

render_bundle() {
  local r c w wf_rows amb_rows min_dbm max_dbm acq err_val amb_pending amb_current
  min_dbm="$(cfg_get min_dbm "$DEFAULT_MIN_DBM")"
  max_dbm="$(cfg_get max_dbm "$DEFAULT_MAX_DBM")"
  r="$(radio_json)"
  c="$( [ -s "$SESSION_FILE" ] && cat "$SESSION_FILE" || echo '{"state":"idle","started_at":0,"ends_at":0,"frames_captured":0,"bytes_written":0,"latest_frame_time":0,"no_frame_count":0,"error":""}' )"
  w="$( [ -s "$WAVEFORM_FILE" ] && cat "$WAVEFORM_FILE" || render_waveform_default )"
  wf_rows="$(json_array_from_lines "$WATERFALL_FILE")"
  amb_rows="$(ambient_rows_json)"
  amb_pending="$(ambient_pending_bool)"
  amb_current="$(ambient_current_json)"
  acq="$( [ -s "$STATE_DIR/acquisition_debug.json" ] && cat "$STATE_DIR/acquisition_debug.json" || acquisition_debug_json )"
  err_val="$(session_num no_frame_count 0)"
  if [ "$(session_num frames_captured 0)" -eq 0 ] 2>/dev/null; then
    c="$(printf '%s' "$c" | sed 's/"error":"[^"]*"/"error":"no parsed frames"/')"
  fi

  local pipe
  pipe="$(pipeline_status_json)"
  cat > "$BUNDLE_FILE" <<JSON
{"ok":true,"radio":$r,"capture":$c,"waveform":$w,"waterfall":{"rows":$wf_rows,"min_dbm":$min_dbm,"max_dbm":$max_dbm},"ambient":{"rows":$amb_rows,"mode":"minute_peak","pending":$amb_pending,"current":$amb_current},"acquisition_debug":$acq,"pipeline":$pipe}
JSON
  cat "$BUNDLE_FILE"
}

capture_once() {
  # stdout: frame JSON if success, empty otherwise
  local phy="$1" bins="$2" snap_bytes="$3" parser="$4" frame raw_out parser_out stats_out
  raw_out="$CAPTURE_FILE"
  parser_out="$FRAME_RAW_FILE"
  stats_out="$STATE_DIR/latest_parser_stats.json"
  frame="$(capture_cycle_sequence "$phy" "$bins" "$snap_bytes" "$parser" "$raw_out" "$parser_out" "$stats_out" "known-good" 1 2>/dev/null || true)"
  [ -n "$frame" ] || return 1
  printf '%s\n' "$frame"
  return 0
}

cleanup_stale() {
  if ! running_pid; then
    rm -f "$PID_FILE" "$END_FILE"
    remove_stale_lock
    [ -s "$SESSION_FILE" ] || write_session "idle" 0 0 0 0 0 0 ""
    store_radio
    render_bundle >/dev/null 2>&1 || true
  fi
}

expire_capture_if_needed() {
  local phy now end pid
  running_pid || return 0
  [ -f "$END_FILE" ] || return 0
  now="$(now_s)"
  end="$(cat "$END_FILE" 2>/dev/null || echo 0)"
  [ "$end" -gt 0 ] 2>/dev/null || return 0
  [ "$now" -lt $((end + 60)) ] && return 0
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
  sleep 1
  [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
  phy="$(resolve_phy)"
  scan_disable "$phy"
  rm -f "$PID_FILE" "$END_FILE"
}

capture_status_cmd() {
  expire_capture_if_needed
  cleanup_stale
  local running="false" now end exists="false" bytes waited=0
  while running_pid && [ "$(session_num frames_captured 0)" -eq 0 ] 2>/dev/null && [ "$waited" -lt 30 ]; do
    sleep 1
    waited=$((waited + 1))
  done
  running_pid && running="true"
  now="$(now_s)"
  end="$(cat "$END_FILE" 2>/dev/null || echo 0)"
  [ -f "$CAPTURE_FILE" ] && exists="true"
  bytes="$(session_num bytes_written 0)"
  cat <<JSON
{"ok":true,"running":$running,"latest_capture":"$CAPTURE_FILE","latest_capture_exists":$exists,"latest_capture_bytes":$bytes,"capture_end":$end,"now":$now,"capture":$( [ -s "$SESSION_FILE" ] && cat "$SESSION_FILE" || echo '{"state":"idle","started_at":0,"ends_at":0,"frames_captured":0,"bytes_written":0,"latest_frame_time":0,"no_frame_count":0,"error":""}' )}
JSON
}

status_cmd() {
  cleanup_stale
  local phy ath ctl scan0 binsf countf parser iface now end running="false" exists="false" bytes
  phy="$(resolve_phy)"
  ath="$(ath_dir "$phy")"
  ctl="$ath/spectral_scan_ctl"
  scan0="$ath/spectral_scan0"
  binsf="$ath/spectral_bins"
  countf="$ath/spectral_count"
  parser="/usr/lib/rfeye/rfeye-spectral-parse"
  iface="$(resolve_iface "$phy")"

  running_pid && running="true"
  [ -f "$CAPTURE_FILE" ] && exists="true"
  bytes="$(session_num bytes_written 0)"
  now="$(now_s)"
  end="$(cat "$END_FILE" 2>/dev/null || echo 0)"

  cat <<JSON
{"ok":true,"phy":"$(json_escape "$phy")","running":$running,"now":$now,"capture_end":$end,"limits":{"max_runtime_seconds":$(cfg_get max_runtime_seconds "$DEFAULT_MAX_RUNTIME"),"max_capture_bytes":$(cfg_get max_capture_bytes "$DEFAULT_MAX_CAPTURE_BYTES"),"snapshot_bytes":$(cfg_get snapshot_bytes "$DEFAULT_SNAPSHOT_BYTES")},"paths":{"spectral_scan_ctl":$( [ -f "$ctl" ] && echo true || echo false ),"spectral_scan0":$( [ -f "$scan0" ] && echo true || echo false ),"spectral_bins":$( [ -f "$binsf" ] && echo true || echo false ),"spectral_count":$( [ -f "$countf" ] && echo true || echo false ),"parser":$( [ -x "$parser" ] && echo true || echo false )},"iface":"$(json_escape "$iface")","latest_capture":"$CAPTURE_FILE","latest_capture_exists":$exists,"latest_capture_bytes":$bytes,"capture":$( [ -s "$SESSION_FILE" ] && cat "$SESSION_FILE" || echo '{"state":"idle","started_at":0,"ends_at":0,"frames_captured":0,"bytes_written":0,"latest_frame_time":0,"no_frame_count":0,"error":""}' )}
JSON
}

update_products_from_frame() {
  local ts="$1" radio="$2" frame="$3" ui_bins="$4" raw_bytes="${5:-0}" parser_exit="${6:-0}" frames_captured="${7:-0}"
  local min_dbm max_dbm freq_valid freq1 width noise rssi bins_csv norm_csv bins_count norm_count
  local rf rw x0 x1 wf_row ring_max wf_rows frame_bytes waterfall_count ambient_count

  min_dbm="$(cfg_get min_dbm "$DEFAULT_MIN_DBM")"
  max_dbm="$(cfg_get max_dbm "$DEFAULT_MAX_DBM")"
  ring_max="$(cfg_get ring_frames "$DEFAULT_RING_FRAMES")"
  wf_rows="$(cfg_get waterfall_rows "$DEFAULT_WATERFALL_ROWS")"
  [ "$ring_max" -gt 2 ] 2>/dev/null || ring_max="$DEFAULT_RING_FRAMES"
  [ "$wf_rows" -gt 2 ] 2>/dev/null || wf_rows="$DEFAULT_WATERFALL_ROWS"

  frame_bytes="$(printf '%s' "$frame" | wc -c | awk '{print int($1)}')"
  freq_valid="$(extract_json_bool "$frame" freq_valid)"
  freq1="$(extract_json_number "$frame" freq1_mhz)"
  width="$(extract_json_number "$frame" width_mhz)"
  noise="$(extract_json_number "$frame" noise)"
  rssi="$(extract_json_number "$frame" rssi)"
  bins_csv="$(extract_bins_csv "$frame")"
  bins_count="$(count_csv_fields "$bins_csv")"
  if [ -z "$bins_csv" ] || [ "$bins_count" -le 0 ] 2>/dev/null; then
    write_pipeline_status "$raw_bytes" "$parser_exit" true "$frame_bytes" false 0 false 0 "$(count_json_rows_file "$WATERFALL_FILE")" "$(ambient_row_count)" "$frames_captured" "bins extraction failed"
    return 1
  fi
  norm_csv="$(normalize_bins_dbm_csv "$bins_csv" "$ui_bins" "$noise" "$min_dbm" "$max_dbm")"
  norm_count="$(count_csv_fields "$norm_csv")"
  if [ -z "$norm_csv" ] || [ "$norm_count" -le 0 ] 2>/dev/null; then
    write_pipeline_status "$raw_bytes" "$parser_exit" true "$frame_bytes" true 0 false 0 "$(count_json_rows_file "$WATERFALL_FILE")" "$(ambient_row_count)" "$frames_captured" "bins normalization failed"
    return 1
  fi

  cat > "$FRAME_FILE" <<JSON
{"timestamp":$ts,"radio":$radio,"frame":{"freq_valid":$freq_valid,"freq1_mhz":$freq1,"width_mhz":$width,"noise":$noise,"rssi":$rssi,"bins":[${norm_csv}]}}
JSON
  append_capped "$RING_FILE" "$(cat "$FRAME_FILE")" "$ring_max"

  rf="$(extract_json_number "$radio" frequency_mhz)"
  rw="$(extract_json_number "$radio" width_mhz)"
  [ "$rw" -gt 0 ] 2>/dev/null || rw="$width"
  [ "$rw" -gt 0 ] 2>/dev/null || rw=20
  x0=$((rf - (rw / 2)))
  x1=$((rf + (rw / 2)))
  [ "$x0" -gt 0 ] 2>/dev/null || x0=0
  [ "$x1" -gt 0 ] 2>/dev/null || x1=0
  cat > "$WAVEFORM_FILE" <<JSON
{"x_start_mhz":$x0,"x_end_mhz":$x1,"bins":[${norm_csv}]}
JSON

  wf_row="{\"timestamp\":$ts,\"bins\":[${norm_csv}]}"
  append_capped "$WATERFALL_FILE" "$wf_row" "$wf_rows"
  update_ambient "$ts" "$norm_csv"
  waterfall_count="$(count_json_rows_file "$WATERFALL_FILE")"
  ambient_count="$(ambient_row_count)"
  write_pipeline_status "$raw_bytes" "$parser_exit" true "$frame_bytes" true "$norm_count" true "$norm_count" "$waterfall_count" "$ambient_count" "$frames_captured" ""
  return 0
}

capture_worker() {
  local phy="$1" seconds="$2" bins="$3" max_bytes="$4" snap_bytes="$5" interval_ms="$6" ui_bins="$7"
  local parser ath scan0 start_ts end_ts now frames bytes nof latest radio frame interval_s err=""
  parser="/usr/lib/rfeye/rfeye-spectral-parse"
  ath="$(ath_dir "$phy")"
  scan0="$ath/spectral_scan0"
  start_ts="$(now_s)"

  finish_worker() {
    local final_state started
    scan_disable "$phy"
    rm -f "$PID_FILE" "$END_FILE"
    started="$(session_num started_at "$start_ts")"
    final_state="$(session_state)"
    [ "$final_state" = "error" ] || final_state="complete"
    [ -n "$err" ] || err="$( [ "$frames" -gt 0 ] 2>/dev/null && echo "" || echo "no parsed frames" )"
    write_session "$final_state" "$started" "$(now_s)" "$frames" "$bytes" "$latest" "$nof" "$err"
    store_radio
    render_bundle >/dev/null 2>&1 || true
  }
  trap 'finish_worker; exit 0' INT TERM EXIT
  trap '' HUP

  if [ ! -f "$scan0" ] || [ ! -x "$parser" ]; then
    err="unsupported spectral path"
    write_session "error" "$(now_s)" "$(now_s)" 0 0 0 0 "$err"
    exit 1
  fi

  case "$bins" in 64|128|256) ;; *) bins="$DEFAULT_BINS" ;; esac
  [ "$snap_bytes" -gt 0 ] 2>/dev/null || snap_bytes="$DEFAULT_SNAPSHOT_BYTES"
  [ "$snap_bytes" -lt 16384 ] 2>/dev/null && snap_bytes=16384
  [ "$snap_bytes" -gt 16384 ] 2>/dev/null && snap_bytes=16384
  [ "$snap_bytes" -gt "$max_bytes" ] && snap_bytes="$max_bytes"
  [ "$ui_bins" -gt 15 ] 2>/dev/null || ui_bins="$DEFAULT_UI_BINS"

  interval_s="$(sleep_interval_ms "$interval_ms")"
  frames=0
  bytes=0
  nof=0
  latest=0

  store_radio
  start_ts="$(now_s)"
  end_ts=$((start_ts + seconds))
  write_session "running" "$start_ts" "$end_ts" "$frames" "$bytes" "$latest" "$nof" ""

  while true; do
    now="$(now_s)"
    [ "$now" -ge "$end_ts" ] && break

    radio="$(radio_info_safe)"
    printf '%s\n' "$radio" > "$RADIO_FILE"

    frame=""
    if acquire_lock; then
      frame="$(capture_once "$phy" "$bins" "$snap_bytes" "$parser" 2>/dev/null || true)"
      release_lock
    fi

    if [ -n "$frame" ]; then
      local cycle_bytes
      cycle_bytes="$(file_size "$CAPTURE_FILE")"
      bytes=$((bytes + cycle_bytes))
      frames=$((frames + 1))
      latest="$(now_s)"
      err=""
      if update_products_from_frame "$latest" "$radio" "$frame" "$ui_bins" "$cycle_bytes" 0 "$frames"; then
        write_session "running" "$start_ts" "$end_ts" "$frames" "$bytes" "$latest" "$nof" "$err"
      else
        err="product update failed"
        write_session "running" "$start_ts" "$end_ts" "$frames" "$bytes" "$latest" "$nof" "$err"
      fi
    else
      nof=$((nof + 1))
      err="no parsed frames"
      write_pipeline_status "$(file_size "$CAPTURE_FILE")" 0 false 0 false 0 false 0 "$(count_json_rows_file "$WATERFALL_FILE")" "$(ambient_row_count)" "$frames" "$err"
      write_session "running" "$start_ts" "$end_ts" "$frames" "$bytes" "$latest" "$nof" "$err"
    fi

    render_bundle >/dev/null 2>&1 || true
    sleep "$interval_s"
  done

  trap - INT TERM EXIT
  trap - HUP
  finish_worker
}

start_cmd() {
  cleanup_stale
  if running_pid; then
    echo '{"ok":false,"error":"capture already running"}'
    return 1
  fi

  local req_seconds="${1:-$(cfg_get max_runtime_seconds "$DEFAULT_MAX_RUNTIME")}" 
  local req_bins="${2:-$(cfg_get bins "$DEFAULT_BINS")}" 
  local phy="${3:-$(resolve_phy)}"
  local max_runtime max_bytes seconds snap_bytes interval_ms ui_bins
  max_runtime="$(cfg_get max_runtime_seconds "$DEFAULT_MAX_RUNTIME")"
  max_bytes="$(cfg_get max_capture_bytes "$DEFAULT_MAX_CAPTURE_BYTES")"
  snap_bytes="$(cfg_get snapshot_bytes "$DEFAULT_SNAPSHOT_BYTES")"
  interval_ms="$(cfg_get sample_interval_ms "$DEFAULT_SAMPLE_INTERVAL_MS")"
  ui_bins="$(cfg_get ui_bins "$DEFAULT_UI_BINS")"

  [ "$req_seconds" -gt 0 ] 2>/dev/null || req_seconds=1
  [ "$max_runtime" -gt 0 ] 2>/dev/null || max_runtime="$DEFAULT_MAX_RUNTIME"
  [ "$max_bytes" -gt 1023 ] 2>/dev/null || max_bytes="$DEFAULT_MAX_CAPTURE_BYTES"
  [ "$snap_bytes" -gt 0 ] 2>/dev/null || snap_bytes="$DEFAULT_SNAPSHOT_BYTES"
  [ "$ui_bins" -gt 15 ] 2>/dev/null || ui_bins="$DEFAULT_UI_BINS"

  seconds="$req_seconds"
  [ "$seconds" -gt "$max_runtime" ] && seconds="$max_runtime"

  mkdir -p "$STATE_DIR"
  echo 0 > "$BYTES_FILE" 2>/dev/null || true

  trap '' HUP
  "$0" __capture_worker "$phy" "$seconds" "$req_bins" "$max_bytes" "$snap_bytes" "$interval_ms" "$ui_bins" > "$STATE_DIR/capture-worker.log" 2>&1 &
  local pid=$!
  trap - HUP
  echo "$pid" > "$PID_FILE"
  echo $(( $(now_s) + seconds )) > "$END_FILE"

  echo "{\"ok\":true,\"running\":true,\"pid\":$pid,\"seconds\":$seconds,\"bins\":$req_bins,\"phy\":\"$(json_escape "$phy")\",\"max_capture_bytes\":$max_bytes,\"sample_interval_ms\":$interval_ms,\"ui_bins\":$ui_bins}"
}

stop_cmd() {
  local phy bytes started frames nof latest
  phy="$(resolve_phy)"
  if running_pid; then
    local pid
    pid="$(cat "$PID_FILE")"
    kill "$pid" 2>/dev/null || true
    sleep 1
    kill -9 "$pid" 2>/dev/null || true
  fi
  scan_disable "$phy"
  rm -f "$PID_FILE" "$END_FILE"

  started="$(session_num started_at 0)"
  frames="$(session_num frames_captured 0)"
  nof="$(session_num no_frame_count 0)"
  latest="$(session_num latest_frame_time 0)"
  bytes="$(session_num bytes_written 0)"
  write_session "complete" "$started" "$(now_s)" "$frames" "$bytes" "$latest" "$nof" ""
  store_radio
  render_bundle >/dev/null 2>&1 || true

  echo "{\"ok\":true,\"running\":false,\"latest_capture\":\"$CAPTURE_FILE\",\"latest_capture_exists\":$( [ -f "$CAPTURE_FILE" ] && echo true || echo false ),\"latest_capture_bytes\":$bytes}"
}

reset_cmd() {
  local phy="${1:-$(resolve_phy)}"
  scan_disable "$phy"
  if ! running_pid; then
    rm -f "$PID_FILE" "$END_FILE" "$CAPTURE_TMP" "$CAPTURE_FILE" "$BYTES_FILE" "$FRAME_FILE" "$FRAME_RAW_FILE" "$RING_FILE" "$WAVEFORM_FILE" "$WATERFALL_FILE" "$AMBIENT_FILE" "$AMBIENT_WORK_FILE" "$BUNDLE_FILE" "$PIPELINE_STATUS_FILE"
    remove_stale_lock
    write_session "idle" 0 0 0 0 0 0 ""
  fi
  store_radio
  render_bundle >/dev/null 2>&1 || true
  echo "{\"ok\":true,\"reset\":true,\"phy\":\"$(json_escape "$phy")\",\"spectral_ctl_after\":\"$(json_escape "$(spectral_ctl_value "$phy")")\"}"
}

snapshot_cmd() {
  local phy parser bins snap_bytes frame r
  phy="$(resolve_phy)"
  parser="/usr/lib/rfeye/rfeye-spectral-parse"
  bins="$(cfg_get bins "$DEFAULT_BINS")"
  snap_bytes="$(cfg_get snapshot_bytes "$DEFAULT_SNAPSHOT_BYTES")"
  r="$(radio_info_safe)"

  if running_pid; then
    if [ -s "$FRAME_RAW_FILE" ]; then
      frame="$(cat "$FRAME_RAW_FILE")"
      echo "{\"ok\":true,\"radio\":$r,\"frame\":$frame,\"diagnostics\":{\"from_buffer\":true,\"spectral_ctl_after\":\"$(json_escape "$(spectral_ctl_value "$phy")")\"}}"
      return 0
    fi
    echo "{\"ok\":false,\"error\":\"no frame\",\"radio\":$r,\"diagnostics\":{\"running\":true,\"from_buffer\":true}}"
    return 1
  fi

  if ! acquire_lock; then
    echo "{\"ok\":false,\"error\":\"capture busy\",\"radio\":$r,\"diagnostics\":{\"lock_busy\":true}}"
    return 1
  fi
  frame="$(capture_once "$phy" "$bins" "$snap_bytes" "$parser" 2>/dev/null || true)"
  release_lock

  if [ -n "$frame" ]; then
    local ts
    ts="$(now_s)"
    update_products_from_frame "$ts" "$r" "$frame" "$(cfg_get ui_bins "$DEFAULT_UI_BINS")" "$(file_size "$CAPTURE_FILE")" 0 1
    write_session "complete" "$ts" "$ts" 1 "$(file_size "$CAPTURE_FILE")" "$ts" 0 ""
    render_bundle >/dev/null 2>&1 || true
    echo "{\"ok\":true,\"radio\":$r,\"frame\":$frame,\"diagnostics\":{\"from_buffer\":false,\"bytes_read\":$(file_size "$CAPTURE_FILE"),\"spectral_ctl_after\":\"$(json_escape "$(spectral_ctl_value "$phy")")\"}}"
    return 0
  fi

  write_session "error" "$(now_s)" "$(now_s)" 0 0 0 $(( $(session_num no_frame_count 0) + 1 )) "no frame"
  render_bundle >/dev/null 2>&1 || true
  echo "{\"ok\":false,\"error\":\"no frame\",\"radio\":$r,\"diagnostics\":{\"spectral_ctl_after\":\"$(json_escape "$(spectral_ctl_value "$phy")")\"}}"
  return 1
}

ui_state_cmd() {
  cleanup_stale
  local r c
  r="$(radio_json)"
  c="$( [ -s "$SESSION_FILE" ] && cat "$SESSION_FILE" || echo '{"state":"idle","started_at":0,"ends_at":0,"frames_captured":0,"bytes_written":0,"latest_frame_time":0,"no_frame_count":0,"error":""}' )"
  echo "{\"ok\":true,\"radio\":$r,\"capture\":$c}"
}

waveform_cmd() {
  cleanup_stale
  echo "{\"ok\":true,\"waveform\":$( [ -s "$WAVEFORM_FILE" ] && cat "$WAVEFORM_FILE" || render_waveform_default )}"
}

waterfall_cmd() {
  cleanup_stale
  echo "{\"ok\":true,\"waterfall\":{\"rows\":$(json_array_from_lines "$WATERFALL_FILE"),\"min_dbm\":$(cfg_get min_dbm "$DEFAULT_MIN_DBM"),\"max_dbm\":$(cfg_get max_dbm "$DEFAULT_MAX_DBM")}}"
}

ambient_cmd() {
  cleanup_stale
  echo "{\"ok\":true,\"ambient\":{\"rows\":$(ambient_rows_json),\"mode\":\"minute_peak\",\"pending\":$(ambient_pending_bool),\"current\":$(ambient_current_json)}}"
}

heatmap_bundle_cmd() {
  cleanup_stale
  render_bundle
}

pipeline_test_cmd() {
  cleanup_stale
  if running_pid; then
    echo '{"ok":false,"error":"capture already running"}'
    return 1
  fi
  local ui_bins="${1:-$(cfg_get ui_bins "$DEFAULT_UI_BINS")}" phy="${2:-$(resolve_phy)}" bins parser snap_bytes raw_out parser_out stats_out frame r ts raw_bytes parser_exit frames_emitted truncated stage_capture=false stage_parse=false stage_bins=false stage_normalize=false stage_latest=false stage_waveform=false stage_waterfall=false stage_ambient=false stage_bundle=false last_error=""
  case "$ui_bins" in ''|*[!0-9]*) ui_bins="$DEFAULT_UI_BINS" ;; esac
  [ "$ui_bins" -gt 15 ] 2>/dev/null || ui_bins="$DEFAULT_UI_BINS"
  bins="$ui_bins"
  case "$bins" in 64|128|256) ;; *) bins="$DEFAULT_BINS" ;; esac
  parser="/usr/lib/rfeye/rfeye-spectral-parse"
  snap_bytes="$(cfg_get max_capture_bytes "$DEFAULT_MAX_CAPTURE_BYTES")"
  [ "$snap_bytes" -lt 65536 ] 2>/dev/null && snap_bytes=65536
  raw_out="$CAPTURE_FILE"
  parser_out="$FRAME_RAW_FILE"
  stats_out="$STATE_DIR/latest_parser_stats.json"

  if acquire_lock; then
    frame="$(capture_cycle_sequence "$phy" "$bins" "$snap_bytes" "$parser" "$raw_out" "$parser_out" "$stats_out" "known-good" 1 2>/dev/null)"
    parser_exit=$?
    release_lock
  else
    frame=""
    parser_exit=1
    last_error="capture busy"
  fi
  raw_bytes="$(file_size "$raw_out")"
  [ "$raw_bytes" -gt 0 ] 2>/dev/null && stage_capture=true
  [ -n "$frame" ] && stage_parse=true
  frames_emitted="$(sed -n 's/.*"frames_emitted":\([0-9][0-9]*\).*/\1/p' "$stats_out" 2>/dev/null | head -n1)"
  truncated="$(sed -n 's/.*"trailing_truncated":\(true\|false\).*/\1/p' "$stats_out" 2>/dev/null | head -n1)"
  [ -n "$frames_emitted" ] || frames_emitted=0
  [ -n "$truncated" ] || truncated=false
  r="$(radio_info_safe)"
  printf '%s
' "$r" > "$RADIO_FILE"
  ts="$(now_s)"
  if [ -n "$frame" ]; then
    local bins_csv norm_csv bins_count norm_count
    bins_csv="$(extract_bins_csv "$frame")"
    bins_count="$(count_csv_fields "$bins_csv")"
    [ "$bins_count" -gt 0 ] 2>/dev/null && stage_bins=true
    norm_csv="$(normalize_bins_dbm_csv "$bins_csv" "$ui_bins" "$(extract_json_number "$frame" noise)" "$(cfg_get min_dbm "$DEFAULT_MIN_DBM")" "$(cfg_get max_dbm "$DEFAULT_MAX_DBM")")"
    norm_count="$(count_csv_fields "$norm_csv")"
    [ "$norm_count" -gt 0 ] 2>/dev/null && stage_normalize=true
    if update_products_from_frame "$ts" "$r" "$frame" "$ui_bins" "$raw_bytes" "$parser_exit" 1; then
      stage_latest=$( [ -s "$FRAME_FILE" ] && echo true || echo false )
      stage_waveform=$( [ -s "$WAVEFORM_FILE" ] && echo true || echo false )
      stage_waterfall=$( [ "$(count_json_rows_file "$WATERFALL_FILE")" -ge 1 ] 2>/dev/null && echo true || echo false )
      stage_ambient=$( [ "$(ambient_row_count)" -ge 1 ] 2>/dev/null && echo true || echo false )
      write_session "complete" "$ts" "$ts" 1 "$raw_bytes" "$ts" 0 ""
    else
      last_error="$(sed -n 's/.*"last_error":"\([^"]*\)".*/\1/p' "$PIPELINE_STATUS_FILE" 2>/dev/null | head -n1)"
      write_session "error" "$ts" "$ts" 0 "$raw_bytes" 0 1 "$last_error"
    fi
  else
    [ -n "$last_error" ] || last_error="no parsed frames"
    write_pipeline_status "$raw_bytes" "$parser_exit" false 0 false 0 false 0 "$(count_json_rows_file "$WATERFALL_FILE")" "$(ambient_row_count)" 0 "$last_error"
    write_session "error" "$ts" "$ts" 0 "$raw_bytes" 0 1 "$last_error"
  fi
  render_bundle >/dev/null 2>&1 && stage_bundle=true || stage_bundle=false
  echo "{\"ok\":$stage_waveform,\"raw_bytes\":$raw_bytes,\"parser_exit\":$parser_exit,\"parser_frame_present\":$stage_parse,\"frames_emitted\":$frames_emitted,\"trailing_truncated\":$truncated,\"stages\":{\"capture_raw_bytes\":$stage_capture,\"parse_resync\":$stage_parse,\"extract_bins\":$stage_bins,\"normalize_bins\":$stage_normalize,\"write_latest_frame\":$stage_latest,\"write_waveform\":$stage_waveform,\"append_waterfall\":$stage_waterfall,\"update_ambient\":$stage_ambient,\"render_heatmap_bundle\":$stage_bundle},\"pipeline\":$(pipeline_status_json)}"
  [ "$stage_waveform" = true ] && [ "$stage_waterfall" = true ] && return 0 || return 1
}

acquisition_debug_cmd() {
  cleanup_stale
  acquisition_debug_json
}

raw_capture_test_cmd() {
  cleanup_stale
  local phy bins seconds parser snap_bytes raw_out parser_out stats_out frame bytes_read frames_emitted truncated start_ts end_ts
  phy="${3:-$(resolve_phy)}"
  seconds="${1:-10}"
  bins="${2:-$(cfg_get bins "$DEFAULT_BINS")}"
  parser="/usr/lib/rfeye/rfeye-spectral-parse"
  snap_bytes="$(cfg_get max_capture_bytes "$DEFAULT_MAX_CAPTURE_BYTES")"
  [ "$snap_bytes" -lt 65536 ] 2>/dev/null && snap_bytes=65536
  [ "$snap_bytes" -gt "$DEFAULT_MAX_CAPTURE_BYTES" ] && snap_bytes="$DEFAULT_MAX_CAPTURE_BYTES"
  raw_out="$RAW_TEST_FILE"
  parser_out="$STATE_DIR/raw-test-parser.txt"
  stats_out="$RAW_TEST_STATS"
  start_ts="$(now_s)"
  end_ts=$((start_ts + seconds))
  frame=""
  while :; do
    frame="$(capture_cycle_sequence "$phy" "$bins" "$snap_bytes" "$parser" "$raw_out" "$parser_out" "$stats_out" "known-good" 1 2>/dev/null || true)"
    [ -n "$frame" ] && break
    [ "$(now_s)" -ge "$end_ts" ] && break
    sleep 1
  done
  bytes_read="$(file_size "$raw_out")"
  frames_emitted="$(sed -n 's/.*"frames_emitted":\([0-9][0-9]*\).*/\1/p' "$stats_out" 2>/dev/null | head -n1)"
  truncated="$(sed -n 's/.*"trailing_truncated":\(true\|false\).*/\1/p' "$stats_out" 2>/dev/null | head -n1)"
  [ -n "$frames_emitted" ] || frames_emitted=0
  [ -n "$truncated" ] || truncated=false
  if [ -n "$frame" ]; then
    echo "{\"ok\":true,\"bytes_read\":$bytes_read,\"frames_emitted\":$frames_emitted,\"trailing_truncated\":$truncated,\"raw_test_file\":\"$RAW_TEST_FILE\",\"parser_stats\":\"$RAW_TEST_STATS\"}"
  else
    echo "{\"ok\":false,\"error\":\"no parsed frames\",\"bytes_read\":$bytes_read,\"frames_emitted\":$frames_emitted,\"trailing_truncated\":$truncated,\"raw_test_file\":\"$RAW_TEST_FILE\",\"parser_stats\":\"$RAW_TEST_STATS\"}"
    return 1
  fi
}

daemon_cmd() {
  while true; do
    if running_pid && [ -f "$END_FILE" ]; then
      local now end
      now="$(now_s)"
      end="$(cat "$END_FILE" 2>/dev/null || echo 0)"
      if [ "$end" -gt 0 ] && [ "$now" -ge "$end" ]; then
        stop_cmd >/dev/null 2>&1 || true
      fi
    fi
    sleep 2
  done
}

cmd="${1:-status}"
shift || true

case "$cmd" in
  status) status_cmd ;;
  capture_status) capture_status_cmd ;;
  radio_info) radio_info_cmd ;;
  ui_state) ui_state_cmd ;;
  waveform) waveform_cmd ;;
  waterfall) waterfall_cmd ;;
  ambient) ambient_cmd ;;
  heatmap_bundle) heatmap_bundle_cmd ;;
  pipeline_status) pipeline_status_cmd ;;
  pipeline_test) pipeline_test_cmd "$@" ;;
  acquisition_debug) acquisition_debug_cmd ;;
  raw_inspect) raw_inspect_cmd ;;
  parser_probe) parser_probe_cmd ;;
  raw_capture_test) raw_capture_test_cmd "$@" ;;
  __capture_worker) capture_worker "$@" ;;
  reset) reset_cmd "${1:-$(resolve_phy)}" ;;
  start) start_cmd "$@" ;;
  stop) stop_cmd ;;
  snapshot) snapshot_cmd ;;
  daemon) daemon_cmd ;;
  *)
    echo '{"ok":false,"error":"usage: rfeye-agent {status|capture_status|radio_info|ui_state|waveform|waterfall|ambient|heatmap_bundle|pipeline_status|pipeline_test [ui_bins phy]|acquisition_debug|raw_inspect|parser_probe|raw_capture_test|reset|start [seconds bins phy]|stop|snapshot|daemon}"}'
    exit 2
    ;;
esac
